{
    "defaultProfile": "kimiCoding",
    "profiles": {
      "Ali-cloud": {
        "provider": "anthropic",
        "baseUrl": "https://coding.dashscope.aliyuncs.com/apps/anthropic",
        "auth": {
          "apiKeyEnv": "ALI_API_KEY"
        },
        "capabilities": {
          "ingress": [
            "anthropic_messages"
          ]
        },
        "defaults": {
          "model": "glm-5",
          "timeoutSeconds": 300,
          "sslVerify": true,
          "retryMax": 8,
          "trustEnv": true
        }
      },
      "mimo": {
        "provider": "anthropic",
        "baseUrl": "https://token-plan-cn.xiaomimimo.com/anthropic",
        "auth": {
          "apiKeyEnv": "MIMO_API_KEY"
        },
        "capabilities": {
          "ingress": [
            "anthropic_messages"
          ]
        },
        "defaults": {
          "model": "mimo-v2.5-pro",
          "timeoutSeconds": 300,
          "sslVerify": true,
          "retryMax": 8,
          "trustEnv": true
        }
      },
      "moonshotAnthropic": {
        "provider": "anthropic",
        "baseUrl": "https://api.moonshot.cn/anthropic",
        "auth": {
          "apiKeyEnv": "MOONSHOT_API_KEY"
        },
        "capabilities": {
          "ingress": [
            "anthropic_messages"
          ]
        },
        "defaults": {
          "model": "kimi-k2.5",
          "timeoutSeconds": 300,
          "sslVerify": true,
          "retryMax": 8,
          "trustEnv": true
        }
      },
      "moonshot": {
        "provider": "openai_compatible",
        "baseUrl": "https://api.moonshot.cn/v1",
        "auth": {
          "apiKeyEnv": "MOONSHOT_API_KEY"
        },
        "capabilities": {
          "ingress": [
            "anthropic_messages",
            "openai_chat"
          ]
        },
        "defaults": {
          "model": "kimi-k2.5",
          "timeoutSeconds": 300,
          "sslVerify": true,
          "retryMax": 8,
          "trustEnv": true
        }
      },
      "kimiCoding": {
        "provider": "anthropic",
        "baseUrl": "https://api.kimi.com/coding",
        "auth": {
          "apiKeyEnv": "KIMI_CODING_API_KEY"
        },
        "capabilities": {
          "ingress": [
            "anthropic_messages"
          ]
        },
        "defaults": {
          "model": "kimi-for-coding",
          "timeoutSeconds": 300,
          "sslVerify": true,
          "retryMax": 8,
          "trustEnv": true
        }
      },
      "deepseek": {
        "provider": "anthropic",
        "baseUrl": "https://api.deepseek.com/anthropic",
        "auth": {
          "apiKeyEnv": "DEEPSEEK_API_KEY"
        },
        "capabilities": {
          "ingress": [
            "anthropic_messages"
          ]
        },
        "defaults": {
          "model": "deepseek-v4-flash",
          "timeoutSeconds": 300,
          "sslVerify": true,
          "retryMax": 8,
          "trustEnv": true
        }
      },
      "volcanoArk-openai": {
        "provider": "openai_compatible",
        "baseUrl": "https://ark.cn-beijing.volces.com/api/v3",
        "auth": {
          "apiKeyEnv": "ARK_API_KEY"
        },
        "capabilities": {
          "ingress": [
            "openai_chat"
          ]
        },
        "defaults": {
          "model": "doubao-seed-2-0-code-preview-260215",
          "timeoutSeconds": 300,
          "sslVerify": true,
          "retryMax": 8,
          "trustEnv": true
        }
      },
      "volcanoArk": {
        "provider": "anthropic",
        "baseUrl": "https://ark.cn-beijing.volces.com/api/compatible",
        "auth": {
          "apiKeyEnv": "ARK_API_KEY"
        },
        "capabilities": {
          "ingress": [
            "anthropic_messages"
          ]
        },
        "defaults": {
          "model": "doubao-seed-2-0-code-preview-260215",
          "timeoutSeconds": 300,
          "sslVerify": true,
          "retryMax": 8,
          "trustEnv": true
        }
      },
      "codexOAuth": {
        "provider": "codex_oauth",
        "baseUrl": "https://api.openai.com/v1",
        "auth": {
          "accountPoolPolicy": {
            "maxFailoverPerRequest": 10
          }
        },
        "features": {
          "enableRequestCompression": true
        },
        "capabilities": {
          "ingress": [
            "anthropic_messages",
            "openai_chat",
            "openai_responses"
          ]
        },
        "defaults": {
          "model": "gpt-5.6-luna",
          "timeoutSeconds": 300,
          "sslVerify": true,
          "retryMax": 8,
          "trustEnv": true
        }
      }
    }
}
