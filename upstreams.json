{
    "defaultProfile": "codexOAuth",
    "profiles": {
      "moonshotAnthropic": {
        "provider": "anthropic",
        "baseUrl": "https://api.moonshot.cn/anthropic",
        "auth": {
          "apiKeyEnv": "MOONSHOT_API_KEY"
        },
        "capabilities": {
          "ingress": [
            "anthropic_messages"
          ]
        },
        "defaults": {
          "model": "kimi-k2.5",
          "timeoutSeconds": 300,
          "sslVerify": true,
          "retryMax": 8,
          "trustEnv": true
        }
      },
      "moonshot": {
        "provider": "openai_compatible",
        "baseUrl": "https://api.moonshot.cn/v1",
        "auth": {
          "apiKeyEnv": "MOONSHOT_API_KEY"
        },
        "capabilities": {
          "ingress": [
            "anthropic_messages",
            "openai_chat"
          ]
        },
        "defaults": {
          "model": "kimi-k2.5",
          "timeoutSeconds": 300,
          "sslVerify": true,
          "retryMax": 8,
          "trustEnv": true
        }
      },
      "codexOAuth": {
        "provider": "codex_oauth",
        "baseUrl": "https://api.openai.com/v1",
        "features": {
          "enableRequestCompression": true
        },
        "capabilities": {
          "ingress": [
            "anthropic_messages",
            "openai_chat",
            "openai_responses"
          ]
        },
        "defaults": {
          "model": "gpt-5.4",
          "timeoutSeconds": 300,
          "sslVerify": true,
          "retryMax": 8,
          "trustEnv": true
        }
      }
    }
}
